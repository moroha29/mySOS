  "faq": [
    {
      "question": "What is the minimum order quantity?",
      "answer": "Minimum quantities vary by product and customisation method. The quotation engine shows accurate options for the selected product."
    },
    {
      "question": "How long is the production lead time?",
      "answer": "Most projects take two to four weeks after artwork and sample approval. Complex custom products may take longer."
    },
    {
      "question": "Can you help with design?",
      "answer": "Yes. We can advise on product selection, print placement and artwork preparation."
    },
    {
      "question": "Do you ship internationally?",
      "answer": "International delivery can be arranged. Shipping is quoted separately based on destination and order size."
    },
    {
      "question": "What file formats do you accept?",
      "answer": "Vector artwork is preferred. High-resolution PNG and PDF files may also be suitable depending on the print method."
    }
  ],
